# --- Firebase (tu CRM propio) ---
# Ruta al archivo JSON de la service account (ver README, sección Firebase)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Nombres de las colecciones de Firestore a buscar, separadas por coma
FIREBASE_COLLECTIONS=agentesProductores,aperturas,companies,reminders
# Nombre de la base de Firestore, SOLO si no es la "(default)" — se ve en
# Firebase > Firestore, arriba de todo, al lado de "Base de datos"
FIREBASE_DATABASE_ID=

# --- Excel: ubicación del/los Excel con info de productores en tu PC ---
# Ruta completa en tu computadora. Podés poner varias separadas por coma.
# Ejemplo: C:\Users\vos\Desktop\Productores.xlsx
EXCEL_PATHS=C:\Users\vos\Desktop\Productores.xlsx

# --- Anthropic (OPCIONAL) ---
# Si la dejás vacía, el resumen se arma igual, solo que ordenando los datos
# encontrados en vez de redactarlos en prosa con IA. No hace falta pagar
# nada para usar el agente.
ANTHROPIC_API_KEY=
